{
  "name": "obsidian-claude-sidebar",
  "version": "0.1.0",
  "description": "옵시디언 사이드바에서 Claude Code(구독)로 노트를 묻고, 다듬고, 정리하는 플러그인",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "node esbuild.config.mjs test && node --test \"test-out/**/*.test.js\"",
    "install-vault": "npm run build && ./install.sh",
    "e2e": "esbuild scripts/e2e.ts --bundle --platform=node --outfile=test-out/e2e.js --log-level=warning && node test-out/e2e.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3"
  }
}
